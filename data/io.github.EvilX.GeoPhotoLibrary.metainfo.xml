  <metadata_license>CC0-1.0</metadata_license>
  <name>GeoPhotoLibrary</name>
  <developer id="io.github.evilx">
    <name>EvilX</name>
  </developer>
  <summary>Browse photos by date and on a world map</summary>
  <summary xml:lang="ru">Просмотр фотографий по датам и на карте мира</summary>
  <summary xml:lang="el">Περιήγηση φωτογραφιών ανά ημερομηνία και στον παγκόσμιο χάρτη</summary>
  <description>
    <p>
      Photo catalog that indexes a folder of photos (JPEG, HEIC, PNG, WebP, TIFF),
      shows them in a year/month/day tree and places them on an OpenStreetMap
      map using GPS coordinates from EXIF metadata.
    </p>
  </description>
  <launchable type="desktop-id">io.github.EvilX.GeoPhotoLibrary.desktop</launchable>
  <url type="homepage">https://github.com/EvilX/geo-photo-library</url>
